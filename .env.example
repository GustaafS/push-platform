# Push Platform Environment Configuration
# Copy this file to .env and update with your values

# =============================================================================
# ENVIRONMENT
# =============================================================================

# Application environment (development, staging, production)
# Affects which Firebase authentication mode is used
NODE_ENV=development


# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/push_platform


# =============================================================================
# API CONFIGURATION
# =============================================================================

# Port for API server
API_PORT=3000

# Host binding for API server
API_HOST=0.0.0.0

# Comma-separated API keys for authentication
# Generate strong random keys for production
# Example: openssl rand -hex 32
API_KEYS=your-secret-api-key-here,another-key-here


# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================

# -------------------------------------
# DEVELOPMENT MODE
# -------------------------------------
# For local development and testing
# Only requires Firebase Project ID (no credentials)

FIREBASE_PROJECT_ID=your-firebase-project-id

# Example: FIREBASE_PROJECT_ID=push-platform-dev-abc123


# -------------------------------------
# PRODUCTION MODE (Option 1: Base64)
# -------------------------------------
# Base64-encoded service account JSON
# Recommended for Docker, Kubernetes, cloud platforms
# Generate using: pnpm --filter api run json-to-base64 /path/to/firebase-credentials.json

# SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Example (full JSON as single line):
# SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"push-platform-prod-abc123","private_key_id":"1234567890abcdef","private_key":"-----BEGIN PRIVATE KEY-----\nMIIE...","client_email":"firebase-adminsdk-xxxxx@push-platform-prod-abc123.iam.gserviceaccount.com","client_id":"123456789012345678901"}


# -------------------------------------
# PRODUCTION MODE (Option 2: File Path)
# -------------------------------------
# Path to firebase-credentials.json file
# Alternative to base64 encoding
# File must be readable by the application

# FIREBASE_CREDENTIALS_PATH=/path/to/firebase-credentials.json

# Example: FIREBASE_CREDENTIALS_PATH=/etc/push-platform/credentials/firebase-credentials.json


# =============================================================================
# WORKER CONFIGURATION
# =============================================================================

# How often worker polls for queued deliveries (milliseconds)
# Lower = faster processing, higher CPU usage
# Recommended: 5000-30000 (5-30 seconds)
WORKER_POLL_INTERVAL_MS=10000

# Number of deliveries to process per batch
# Higher = more throughput, more memory usage
# Recommended: 50-200
WORKER_BATCH_SIZE=100

# Maximum number of retry attempts for failed deliveries
# After this limit, delivery is marked as permanently failed
# Recommended: 3-10
MAX_RETRY_COUNT=5


# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Logging level (debug, info, warn, error)
# LOG_LEVEL=info

# Additional worker settings
# WORKER_CONCURRENCY=1
# WORKER_MAX_MEMORY_MB=512

# Database connection pool settings
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10


# =============================================================================
# CONFIGURATION NOTES
# =============================================================================

# Development vs Production Firebase Configuration:
#
# DEVELOPMENT (NODE_ENV=development):
#   - Requires: FIREBASE_PROJECT_ID only
#   - No service account credentials needed
#   - Firebase Admin SDK initializes in "project ID only" mode
#   - Suitable for local testing, emulator usage
#
# PRODUCTION (NODE_ENV=production or staging):
#   - Requires: SERVICE_ACCOUNT_JSON OR FIREBASE_CREDENTIALS_PATH
#   - Full service account credentials needed
#   - Enables sending real push notifications
#   - Choose one approach:
#     - Base64 (SERVICE_ACCOUNT_JSON) - easier for containers
#     - File path (FIREBASE_CREDENTIALS_PATH) - easier for traditional servers
#
# Per-Application Firebase Configuration:
#   - Applications can have their own Firebase configs stored in database
#   - Override global SERVICE_ACCOUNT_JSON on a per-app basis
#   - Enables multi-tenant / white-label deployments
#   - Configure via: pnpm --filter api run add-app-firebase-config
#   - See docs/implementation/multi-app-configuration.md


# =============================================================================
# SECURITY WARNINGS
# =============================================================================

# WARNING: NEVER commit this .env file to version control
# WARNING: NEVER commit firebase-credentials.json to version control
# WARNING: NEVER commit .p8 APNs key files to version control
# WARNING: NEVER commit GoogleService-Info.plist to version control
#
# These files contain sensitive credentials that can:
# - Allow unauthorized access to your Firebase project
# - Send push notifications as your application
# - Access or modify data in your Firebase services
#
# Best Practices:
# 1. Use separate Firebase projects for dev/staging/prod
# 2. Rotate service account keys every 90 days
# 3. Use secret management systems in production (AWS Secrets Manager, etc.)
# 4. Limit access to credentials to essential personnel only
# 5. Monitor Firebase usage and audit logs regularly


# =============================================================================
# VALIDATION
# =============================================================================

# After configuring, validate your setup:
#
# 1. Validate all environment variables:
#    pnpm --filter api run validate-env
#
# 2. Validate Firebase configuration specifically:
#    pnpm --filter api run validate-firebase
#
# 3. Validate service account (if using):
#    pnpm --filter api run validate-service-account /path/to/firebase-credentials.json
#
# 4. List Firebase configurations per application:
#    pnpm --filter api run list-firebase-configs


# =============================================================================
# QUICK START
# =============================================================================

# Development Setup:
# 1. Copy this file: cp .env.example .env
# 2. Set FIREBASE_PROJECT_ID to your Firebase project ID
# 3. Update DATABASE_URL with your PostgreSQL connection
# 4. Update API_KEYS with strong random keys
# 5. Run: pnpm --filter api run validate-env
# 6. Run migrations: pnpm migrate
# 7. Seed data: pnpm --filter api run seed-data
# 8. Start API: pnpm --filter api dev
# 9. Start worker: pnpm --filter worker dev
#
# Production Setup:
# 1. Generate service account JSON from Firebase Console
# 2. Convert to base64: pnpm --filter api run json-to-base64 /path/to/firebase-credentials.json
# 3. Set SERVICE_ACCOUNT_JSON with the base64 output
# 4. Set NODE_ENV=production
# 5. Configure all other required variables
# 6. Deploy and validate


